--- /dev/null
+++ b/k9_patrol_console/tests/test_perf_rotate.py
@@ -0,0 +1,46 @@
+import sys
+from pathlib import Path
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import rotate_detect as rd
+from perf_meter import PerfMeter
+
+
+def person(code, too_close=False):
+    return dict(target='person', posture=dict(code=code, metrics=dict(too_close=True) if too_close else {}))
+
+
+def test_should_run_modes():
+    assert rd.should_run([person('standing')], 'always')
+    assert not rd.should_run([person('standing')], 'unknown')
+    assert rd.should_run([person('standing'), person('unknown')], 'unknown')
+    assert not rd.should_run([person('unknown', too_close=True)], 'unknown')
+    assert not rd.should_run([], 'unknown')
+    assert rd.should_run([], 'unknown_or_empty')
+
+
+def test_perf_summary_and_log(tmp_path):
+    m = PerfMeter(tmp_path, window=10, log_every=0)
+    for i in range(11):
+        m.add(i * .5, .1, i % 2 == 0, 'always')
+    s = m.summary()
+    assert s['fps'] == 2.0 and s['infer_ms'] == 100.0 and 0.5 <= s['rotate_ratio'] <= 0.6
+    assert (tmp_path / 'perf_log.csv').read_text(encoding='utf-8').startswith('time,rotate,fps')
+
+
+def test_settings_and_default():
+    assert set(rd.SETTINGS) == {'off', 'unknown', 'unknown_or_empty', 'always', 'always_both'}
+    assert rd.default_setting() in rd.SETTINGS
+
+
+def test_speech_hotwords_config(tmp_path):
+    import types
+    import speech
+    store = types.SimpleNamespace(root=tmp_path, list=lambda: [])
+    rec = speech.SpeechRecorder(store, None, None)
+    assert rec.status()['hotwords'] == ''
+    rec.configure(dict(model='small', hotwords='  살려주세요   도와주세요 '))
+    assert rec.status()['hotwords'] == '살려주세요 도와주세요'
+    again = speech.SpeechRecorder(store, None, None)
+    assert again.status()['hotwords'] == '살려주세요 도와주세요'
+    rec.configure(dict(model='small', hotwords=''))
+    assert rec.status()['hotwords'] == ''
