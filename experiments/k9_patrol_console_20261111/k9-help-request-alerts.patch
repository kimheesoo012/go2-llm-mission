+"""Re-score a saved --mode llm run with the current merge rules, without calling the LLM.
+
+The LLM's picks and reasons are read from a saved selection_llm.md, so a change to
+review_priority.py can be checked against what the model really wrote.
+
+Usage (from k9_patrol_console/):
+    python eval/replay_llm_run.py eval/run_20261112/selection_llm.md
+"""
+import json
+import re
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+sys.path.insert(0, str(ROOT / 'eval'))
+from review_priority import merge_selection  # noqa: E402
+from selection_eval import score  # noqa: E402
+
+
+def main():
+    saved = Path(sys.argv[1]).read_text(encoding='utf-8')
+    picks = {}
+    for n, rid, reason in re.findall(r'^- (\d+)\. (r\d+) \(llm\): (.*)$', saved, re.M):
+        picks.setdefault(int(n), []).append(dict(id=rid, reason=reason, evidence=[]))
+    scenarios = json.loads((ROOT / 'eval' / 'selection_scenarios.json').read_text(encoding='utf-8'))['scenarios']
+    lines = ['# 저장된 LLM 선정 결과에 현재 병합 규칙 적용 (LLM 재호출 없음)', '', f'입력: {sys.argv[1]}', '',
+             '| # | 시나리오 | LLM만 | 규칙 우선 + 이유 검증 | 놓침 | 불필요 선정 | 판정 |', '|---|---|---|---|---|---|---|']
+    passed, notes = 0, []
+    for n, s in enumerate(scenarios, 1):
+        llm = picks.get(n, [])
+        dropped = []
+        items = merge_selection(s['records'], llm, s['limit'], dropped)[0]
+        ids = [x['id'] for x in items]
+        r = score(s, ids)
+        passed += r['passed']
+        lines.append(f"| {n} | {s['name']} | {', '.join(x['id'] for x in llm) or '없음'} | {', '.join(ids) or '없음'} | "
+                     f"{', '.join(r['missed']) or '-'} | {', '.join(r['wrong']) or '-'} | {'O' if r['passed'] else 'X'} |")
+        notes += [f"- {n}. {d['id']} LLM 추가 선정 제외 ({d['why']}): {d['reason']}" for d in dropped]
+        notes += [f"- {n}. {x['id']} LLM 이유 대신 규칙 문장 사용 ({x['llm_reason_rejected']})" for x in items if x.get('llm_reason_rejected')]
+    lines += ['', f'통과 {passed}/{len(scenarios)}', '', '## 이유 문장 검증으로 바뀐 것'] + notes
+    text = '\n'.join(lines) + '\n'
+    Path(sys.argv[1]).with_name('replay_with_reason_check.md').write_text(text, encoding='utf-8')
+    print(text)
+
+
+if __name__ == '__main__':
+    main()
