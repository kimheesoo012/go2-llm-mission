index 0000000..b36e9bc
--- /dev/null
+++ b/k9_patrol_console/tests/test_help_request.py
@@ -0,0 +1,108 @@
+import pytest
+from help_request import find_help_request, similarity, jamo_distance, tokens
+
+
+def code(text):
+    return find_help_request(text)['code']
+
+
+# --- exact help phrases -------------------------------------------------
+@pytest.mark.parametrize('text', [
+    '살려주세요', '살려 주세요', '살려주세요! 살려주세요!', '도와주세요', '도와 주세요', '도와줘', '살려줘요',
+    '사람 살려', '살려', '사람살려주세요', '제발 좀 도와주세요', '여기 구해주세요', '구해 줘', '119 불러주세요',
+    '구급차 좀 불러주세요', '살려주세요\n도와주세요\n살려주세요',
+])
+def test_help(text):
+    r = find_help_request(text)
+    assert r['code'] == 'help' and r['priority'] == 3 and r['label'] == '도움 요청'
+
+
+# --- must NOT be help: same stems in ordinary sentences -----------------
+@pytest.mark.parametrize('text', [
+    '도와주셔서 감사합니다', '도와줘서 고마워', '도와드릴까요', '제가 도와줄게요', '분위기를 살려야 해요',
+    '친구 해주세요', '친구해줘', '그 책은 어디서 구해요', '1190원입니다', '안녕하세요', '', '   ', None, 123,
+])
+def test_not_help(text):
+    assert code(text) == 'none'
+
+
+# --- real 11/05 records --------------------------------------------------
+def test_1105_misheard_four_times():
+    r = find_help_request('사랑해주세요 사랑해주세요 사랑해주세요 사랑해주세요')
+    assert r['code'] == 'suspect' and r['priority'] == 2
+    hit = r['hits'][0]
+    assert (hit['text'], hit['kind'], hit['target'], hit['count']) == ('사랑해주세요', 'repeat', '살려주세요', 4)
+    assert '원본 음성 확인 필요' in r['reason']
+
+
+def test_1105_help_with_misheard_tail():
+    r = find_help_request('살려주세요 살려주세요 눈 와주세요 눈 와주세요')
+    assert r['code'] == 'help'
+    assert [(h['text'], h['count']) for h in r['hits']] == [('살려주세요', 2), ('와주세요', 2)]
+
+
+def test_misheard_tail_alone_is_suspect():
+    r = find_help_request('눈 와주세요 눈 와주세요')
+    assert r['code'] == 'suspect' and r['hits'][0]['target'] == '도와주세요'
+
+
+# --- suspect: one jamo away, not a word ----------------------------------
+@pytest.mark.parametrize('text', ['살려조세요', '도와주세오', '살러주세요', '더와주세요'])
+def test_near_once(text):
+    r = find_help_request(text)
+    assert r['code'] == 'suspect' and r['priority'] == 1 and r['hits'][0]['kind'] == 'near'
+
+
+# --- ordinary requests said once are not flagged -------------------------
+@pytest.mark.parametrize('text', [
+    '사랑해주세요', '길 좀 알려주세요', '이것 좀 보여주세요', '문 좀 열어주세요', '확인 해주세요', '이리 와주세요',
+    '잠깐만 기다려주세요', '여기서 내려주세요', '조용히 해주세요', '사진 좀 봐주세요', '좀 비켜주세요',
+])
+def test_similar_once_is_not_flagged(text):
+    r = find_help_request(text)
+    assert r['code'] == 'none'
+
+
+def test_single_similar_is_kept_as_weak():
+    r = find_help_request('사랑해주세요')
+    assert r['weak'] and r['weak'][0]['text'] == '사랑해주세요' and r['hits'] == []
+
+
+def test_ordinary_lookalike_needs_repetition():
+    assert code('알려주세요') == 'none'
+    assert code('알려주세요 알려주세요') == 'suspect'
+
+
+def test_different_ordinary_requests_do_not_add_up():
+    # Two different requests are not a repetition.
+    assert code('이것 좀 보여주세요 그리고 저기서 내려주세요') == 'none'
+
+
+def test_repeat_priority():
+    assert find_help_request('사랑해주세요 사랑해주세요')['priority'] == 1
+    assert find_help_request('사랑해주세요 사랑해주세요 사랑해주세요')['priority'] == 2
+
+
+def test_transcript_is_not_rewritten():
+    r = find_help_request('사랑해주세요, 사랑해주세요.')
+    assert r['hits'][0]['text'] == '사랑해주세요'  # as written, never "살려주세요"
+
+
+def test_similarity_values_used_in_notes():
+    assert round(similarity('사랑해주세요', '살려주세요'), 2) == 0.75
+    assert round(similarity('안녕하세요', '살려주세요'), 2) == 0.52
+    assert jamo_distance('살려조세요', '살려주세요') == 1
+    assert jamo_distance('사랑해주세요', '살려주세요') > 1
+    assert tokens('살려주세요!! (큰 소리) help 119') == ['살려주세요', '큰', '소리', '119']
+
+
+def test_split_help_phrase_is_one_hit():
+    r = find_help_request('살려 주세요 살려 주세요')
+    assert r['code'] == 'help' and [(h['text'], h['count']) for h in r['hits']] == [('살려주세요', 2)] and r['weak'] == []
+    assert find_help_request('사람 살려 주세요')['hits'][0]['text'] == '살려주세요'
+
+
+def test_bare_ending_is_not_a_candidate():
+    for text in ('물 주세요 물 주세요', '이거 주세요 저거 주세요 그것도 주세요', '줘 줘 줘'):
+        r = find_help_request(text)
+        assert r['code'] == 'none' and r['weak'] == []
diff --git a/k9_patrol_console/tests/test_lying_tracker.py b/k9_patrol_console/tests/test_lying_tracker.py
new file mode 100644
index 0000000..d8cca75
--- /dev/null
+++ b/k9_patrol_console/tests/test_lying_tracker.py
@@ -0,0 +1,138 @@
+from lying_tracker import LyingTracker, iou
+
+BOX = [100, 300, 400, 380]
+
+
+def det(code, box=BOX):
+    return dict(target='person', xyxy=list(box), posture=dict(code=code))
+
+
+def run(tracker, frames, fps=5, start=0.):
+    """frames: list of detection lists. Returns [(time, event), ...]."""
+    out = []
+    for i, dets in enumerate(frames):
+        now = start + i / fps
+        out += [(now, e) for e in tracker.update(now, dets)]
+    return out
+
+
+def names(events):
+    return [e['event'] for _, e in events]
+
+
+def test_iou():
+    assert iou([0, 0, 10, 10], [0, 0, 10, 10]) == 1
+    assert iou([0, 0, 10, 10], [20, 20, 30, 30]) == 0
+    assert round(iou([0, 0, 10, 10], [5, 0, 15, 10]), 3) == 0.333
+
+
+def test_one_lying_frame_is_not_an_event():
+    t = LyingTracker(sustain=5)
+    ev = run(t, [[det('standing')]] * 10 + [[det('lying')]] + [[det('standing')]] * 10)
+    assert ev == []
+
+
+def test_sustained_lying_fires_once_at_the_threshold():
+    t = LyingTracker(sustain=5)
+    ev = run(t, [[det('lying')]] * 60)  # 12 s
+    assert names(ev) == ['lying_sustained']
+    when, e = ev[0]
+    assert when == 5.0 and e['seconds'] == 5.0 and e['ratio'] == 1.0
+    assert '쓰러' not in e['message'] and '낙상' not in e['message']
+
+
+def test_short_lying_does_not_fire():
+    t = LyingTracker(sustain=5)
+    assert run(t, [[det('lying')]] * 20 + [[det('standing')]] * 20) == []  # 4 s lying
+
+
+def test_unknown_frames_inside_the_gap_are_tolerated():
+    t = LyingTracker(sustain=5, gap=2)
+    frames = ([[det('lying')]] * 10 + [[det('unknown')]] * 5) * 3  # 1 s unknown in every 3 s
+    assert names(run(t, frames)) == ['lying_sustained']
+
+
+def test_missed_detections_inside_the_gap_are_tolerated():
+    t = LyingTracker(sustain=5, gap=2)
+    frames = [[det('lying')]] * 10 + [[]] * 7 + [[det('lying')]] * 30
+    ev = run(t, frames)
+    assert names(ev) == ['lying_sustained'] and ev[0][0] < 6
+
+
+def test_long_unknown_ends_the_span():
+    t = LyingTracker(sustain=5, gap=2)
+    frames = [[det('lying')]] * 15 + [[det('unknown')]] * 15 + [[det('lying')]] * 15  # 3 s, 3 s unknown, 3 s
+    assert run(t, frames) == []
+
+
+def test_mostly_unknown_does_not_fire():
+    # Lying is seen only once per 1.8 s: the span survives the gap but the ratio is too low.
+    t = LyingTracker(sustain=5, gap=2)
+    frames = ([[det('lying')]] + [[det('unknown')]] * 8) * 6
+    assert run(t, frames) == []
+
+
+def test_standing_up_ends_the_span_and_reports_it():
+    t = LyingTracker(sustain=5, reset=1)
+    ev = run(t, [[det('lying')]] * 30 + [[det('standing')]] * 10)
+    assert names(ev) == ['lying_sustained', 'lying_ended']
+    assert ev[1][1]['reason'] == '서 있음·앉아 있음으로 바뀜'
+
+
+def test_one_upright_frame_does_not_reset():
+    t = LyingTracker(sustain=5, reset=1)
+    frames = [[det('lying')]] * 12 + [[det('sitting')]] + [[det('lying')]] * 20
+    ev = run(t, frames)
+    assert names(ev) == ['lying_sustained'] and ev[0][0] == 5.0
+
+
+def test_fires_again_after_getting_up_and_lying_down_again():
+    t = LyingTracker(sustain=5)
+    frames = [[det('lying')]] * 30 + [[det('standing')]] * 10 + [[det('lying')]] * 30
+    assert names(run(t, frames)) == ['lying_sustained', 'lying_ended', 'lying_sustained']
+
+
+def test_two_people_are_followed_separately():
+    t = LyingTracker(sustain=5)
+    other = [600, 100, 700, 400]
+    frames = [[det('lying'), det('standing', other)]] * 30
+    ev = run(t, frames)
+    assert names(ev) == ['lying_sustained']
+    assert [s['track'] for s in t.status()] == [ev[0][1]['track']]
+
+
+def test_passerby_overlapping_does_not_take_over_the_lying_span():
+    t = LyingTracker(sustain=5)
+    walker = [[x, 100, x + 100, 420] for x in range(0, 600, 20)]
+    frames = [[det('lying'), det('standing', w)] for w in walker]
+    assert names(run(t, frames)) == ['lying_sustained']
+
+
+def test_camera_turn_keeps_the_single_lying_person():
+    t = LyingTracker(sustain=5)
+    frames = [[det('lying', [100, 300, 400, 380])]] * 15 + [[det('lying', [520, 300, 820, 380])]] * 15
+    assert names(run(t, frames)) == ['lying_sustained']
+
+
+def test_person_leaving_the_frame_drops_the_track():
+    t = LyingTracker(sustain=5, gap=2)
+    ev = run(t, [[det('lying')]] * 30 + [[]] * 15)
+    assert names(ev) == ['lying_sustained', 'lying_ended'] and t.tracks == []
+
+
+def test_non_person_and_bad_detections_are_ignored():
+    t = LyingTracker(sustain=1)
+    frames = [[dict(target='backpack', xyxy=BOX, posture=dict(code='lying')), dict(target='person'), dict(target='person', xyxy=[1, 2])]] * 20
+    assert run(t, frames) == [] and t.tracks == []
+
+
+def test_detection_without_posture_counts_as_unknown():
+    t = LyingTracker(sustain=5, gap=2)
+    frames = [[det('lying')]] * 10 + [[dict(target='person', xyxy=BOX)]] * 20
+    assert run(t, frames) == []
+
+
+def test_default_threshold_is_15_seconds():
+    t = LyingTracker()
+    ev = run(t, [[det('lying')]] * 100)
+    assert ev[0][0] == 15.0 and '15초' in ev[0][1]['message']
diff --git a/k9_patrol_console/tests/test_patrol_report.py b/k9_patrol_console/tests/test_patrol_report.py
new file mode 100644
index 0000000..2aea2e6
--- /dev/null
+++ b/k9_patrol_console/tests/test_patrol_report.py
@@ -0,0 +1,126 @@
+import json
+import pytest
+from patrol_report import build_facts, rule_overview, check_overview, make_report
+
+
+def obs(i, time, transcript='', count=1, labels=()):
+    return dict(record_id=f'{i:032x}', time=time, transcript=transcript, person_seen=count is not None,
+                person_count=count, postures=[dict(frame_person_index=n, label=l) for n, l in enumerate(labels, 1)])
+
+
+RECORDS = [
+    obs(1, '2026-11-05T10:01:38+00:00', labels=['서 있음']),
+    obs(2, '2026-11-05T10:03:10+00:00', labels=['앉아 있음', '판단 불가'], count=2),
+    obs(3, '2026-11-05T10:05:00+00:00', '사랑해주세요 사랑해주세요 사랑해주세요 사랑해주세요', labels=['누워 있음']),
+    obs(4, '2026-11-05T10:06:20+00:00', '살려주세요 살려주세요 눈 와주세요 눈 와주세요', labels=['누워 있음']),
+    obs(5, '2026-11-05T10:09:00+00:00', '안녕하세요', count=None),
+    obs(6, '2026-11-05T10:12:00Z', labels=['앉아 있음']),
+]
+
+
+def fake_chat(text):
+    def chat(payload):
+        chat.payload = payload
+        return {'message': {'content': json.dumps({'overview': text}, ensure_ascii=False)}}
+    return chat
+
+
+def test_facts():
+    f = build_facts(list(reversed(RECORDS)))  # order of input does not matter
+    assert (f['date'], f['start'], f['end'], f['minutes']) == ('2026-11-05', '19:01', '19:12', 10)  # KST
+    assert (f['records'], f['person_records'], f['max_people_in_frame'], f['speech_records']) == (6, 5, 2, 3)
+    assert (f['help_records'], f['suspect_records'], f['lying_records'], f['lying_sustained_records']) == (1, 1, 2, 0)
+    assert f['postures'] == {'앉아 있음': 2, '누워 있음': 2, '서 있음': 1, '판단 불가': 1}
+    assert [(e['time'], e['kinds']) for e in f['events']] == [
+        ('11-05 19:05:00', ['도움 요청 의심 발화', '누운 자세 후보']), ('11-05 19:06:20', ['도움 요청 발화', '누운 자세 후보'])]
+    assert f['position'] == '미수신'
+
+
+def test_no_records():
+    for empty in ([], None, [dict(time='not a time')], [dict(transcript='x')]):
+        with pytest.raises(ValueError):
+            build_facts(empty)
+
+
+def test_rule_overview_with_and_without_flags():
+    text = rule_overview(build_facts(RECORDS))
+    assert '기록 6건' in text and '도움 요청 발화 1건, 도움 요청 의심 발화 1건, 누운 자세 후보 2건' in text and '원본 영상·음성 확인' in text
+    quiet = rule_overview(build_facts(RECORDS[:2]))
+    assert '표시된 기록은 없습니다' in quiet
+
+
+def test_report_without_llm():
+    r = make_report(RECORDS)
+    assert r['overview_source'] == 'rule' and r['llm_error'] == ''
+    md = r['markdown']
+    assert '# 순찰 보고서 · 2026-11-05' in md and '위치: 미수신' in md and '- 기간: 2026-11-05 19:01~19:12 (약 10분' in md and '| 11-05 19:06:20 | 도움 요청 발화 + 누운 자세 후보 |' in md
+    assert "'사랑해주세요' 4회 반복" in md and '총평 작성: 규칙 문장' in md
+
+
+def test_report_uses_valid_llm_text():
+    chat = fake_chat('19:01부터 19:12까지 기록 6건이 저장되었습니다. 도움 요청 발화 1건과 누운 자세 후보 2건은 원본 확인이 필요합니다.')
+    r = make_report(RECORDS, 'qwen3.5:4b', chat)
+    assert r['overview_source'] == 'llm' and r['overview'].startswith('19:01부터')
+    p = chat.payload
+    assert p['think'] is False and p['options']['temperature'] == 0 and p['format']['required'] == ['overview']
+    sent = json.loads(p['messages'][1]['content'])
+    assert sent['records'] == 6 and 'transcript' not in json.dumps(sent)  # only computed facts go to the LLM
+
+
+@pytest.mark.parametrize('text,why', [
+    ('기록 7건이 저장되었고 사람이 탐지되었습니다.', '집계에 없는 숫자'),
+    ('기록 6건 중 한 명이 쓰러져 있었던 것으로 보입니다.', '단정 표현'),
+    ('누운 사람은 의식이 없는 것으로 추정됩니다. 기록 6건.', '단정 표현'),
+    ('짧음', '총평 길이'),
+])
+def test_bad_llm_text_falls_back_to_rules(text, why):
+    r = make_report(RECORDS, 'qwen3.5:4b', fake_chat(text))
+    assert r['overview_source'] == 'rule' and why in r['llm_error'] and '기록 6건' in r['overview']
+
+
+def test_llm_failure_falls_back_to_rules():
+    def down(payload):
+        raise ConnectionError('Ollama 연결 실패')
+    r = make_report(RECORDS, 'qwen3.5:4b', down)
+    assert r['overview_source'] == 'rule' and 'ConnectionError' in r['llm_error'] and r['markdown']
+
+    def wrong_shape(payload):
+        return {'message': {'content': '{"overview":"기록 6건 저장.","extra":1}'}}
+    assert 'ValueError' in make_report(RECORDS, 'm', wrong_shape)['llm_error']
+
+
+def test_check_overview_accepts_times_and_counts_from_facts():
+    f = build_facts(RECORDS)
+    assert check_overview('2026-11-05 19:01~19:12, 약 10분 동안 기록 6건, 사람 탐지 5건.', f)
+
+
+def test_sustained_lying_record_is_listed_separately():
+    rec = dict(obs(7, '2026-11-05T10:14:00+00:00', labels=['누워 있음 후보']), lying_sustained=dict(seconds=15.2, ratio=0.9, threshold_seconds=15.0))
+    r = make_report(RECORDS + [rec])
+    f = r['facts']
+    assert (f['lying_sustained_records'], f['lying_records']) == (1, 2)
+    assert f['events'][-1]['kinds'] == ['누운 자세 지속'] and '15.2초 이상 지속 관측' in f['events'][-1]['detail']
+    assert '누운 자세 지속 1건' in r['overview'] and '| 누운 자세 지속 (추적 기준) | 1 |' in r['markdown']
+
+
+def test_records_from_several_days_are_a_period_not_one_patrol():
+    r = make_report(RECORDS + [obs(9, '2026-11-02T10:51:21+00:00', labels=['서 있음 후보'])])
+    f = r['facts']
+    assert f['period'] == '2026-11-02 19:51 ~ 2026-11-05 19:12' and f['length'] == '약 3일' and f['single_day'] is False
+    assert r['markdown'].startswith('# 순찰 보고서 · 2026-11-02 ~ 2026-11-05') and '기간에 기록 7건' in r['overview']
+
+
+def test_rejected_llm_text_is_kept_for_review_but_not_used():
+    text = '기록 6건 중 한 명이 쓰러져 있었던 것으로 보입니다.'
+    r = make_report(RECORDS, 'qwen3.5:4b', fake_chat(text))
+    assert r['llm_rejected_text'] == text and text not in r['markdown'] and r['overview_source'] == 'rule'
+    assert make_report(RECORDS)['llm_rejected_text'] == ''
+
+
+def test_thousands_separator_is_not_a_new_number():
+    f = build_facts(RECORDS + [obs(9, '2026-11-02T10:51:21+00:00')])
+    assert f['minutes'] == 4281
+    assert check_overview('약 3일간 총 4,281 분 동안 기록 7건이 저장되었습니다.', f)
+    import pytest as _p
+    with _p.raises(ValueError):
+        check_overview('총 4,282 분 동안 기록 7건이 저장되었습니다.', f)
