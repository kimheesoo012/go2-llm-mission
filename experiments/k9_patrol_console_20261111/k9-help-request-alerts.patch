+"""The rule modules wired into the console code (speech.py, vision.py, highlights.py, app.py).
+
+No robot, no STT model, no Ollama: the STT library and the LLM call are replaced by
+test doubles. Stored records come from a copy of data/ (never the live folder).
+"""
+import json
+import shutil
+import sys
+import time
+import types
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parent.parent
+MISHEARD = '0e654017'   # 11/05 "사랑해주세요" x4
+HELP = '81e320cb'       # 11/05 "살려주세요" x2 + "눈 와주세요" x2
+
+
+@pytest.fixture
+def store(tmp_path):
+    from storage import Store
+    (tmp_path / 'data').mkdir()
+    shutil.copy(ROOT / 'data' / 'records.sqlite3', tmp_path / 'data' / 'records.sqlite3')
+    return Store(tmp_path / 'data')
+
+
+@pytest.fixture
+def empty_store(tmp_path):
+    from storage import Store
+    return Store(tmp_path / 'empty')
+
+
+def jpeg():
+    cv2 = pytest.importorskip('cv2')
+    np = pytest.importorskip('numpy')
+    ok, raw = cv2.imencode('.jpg', np.zeros((120, 160, 3), np.uint8))
+    return raw.tobytes()
+
+
+# ---------------------------------------------------------------- speech
+class FakeRobot:
+    loop = None
+
+    def status(self):
+        return dict(connected=False)
+
+
+def fake_whisper(monkeypatch, lines):
+    class Segment:
+        def __init__(self, i, text):
+            self.start, self.end, self.text = i * 2.0, i * 2.0 + 2, text
+
+    class WhisperModel:
+        def __init__(self, *a, **k):
+            pass
+
+        def transcribe(self, path, **kwargs):
+            return [Segment(i, t) for i, t in enumerate(lines)], None
+
+    monkeypatch.setitem(sys.modules, 'faster_whisper', types.SimpleNamespace(WhisperModel=WhisperModel))
+
+
+def speech_record(store, monkeypatch, lines):
+    from alerts import AlertCenter
+    from speech import SpeechRecorder
+    from vision import Vision
+    fake_whisper(monkeypatch, lines)
+    recorder = SpeechRecorder(store, FakeRobot(), Vision(store))
+    recorder.alerts = AlertCenter()
+    meta = dict(event_kind='speech', model='small', started_at='2026-11-11T05:00:00+00:00', transcript='', segments=[])
+    recorder._process(b'\x00\x00' * 16000, None, 'session-x', meta)
+    record = next(r for r in store.list() if r['session'] == 'session-x')
+    return record, recorder.alerts
+
+
+def test_speech_record_gets_the_rule_level_and_an_alert(empty_store, monkeypatch):
+    record, alerts = speech_record(empty_store, monkeypatch, ['사랑해주세요'] * 4)
+    meta = record['metadata']
+    assert record['state'] == 'ready' and meta['transcript'] == '사랑해주세요\n사랑해주세요\n사랑해주세요\n사랑해주세요'  # stored as heard
+    assert meta['help_request']['code'] == 'suspect' and meta['help_request']['hits'][0]['count'] == 4
+    side = json.loads((empty_store.media / (record['id'] + '.json')).read_text(encoding='utf-8'))
+    assert side['help_request']['label'] == '도움 요청 의심'
+    active = alerts.active()
+    assert [(a['level'], a['title'], a['record_ids']) for a in active] == [(2, '도움 요청 의심 발화', [record['id']])]
+    assert [r['id'] for r in empty_store.list(query='도움 요청')] == [record['id']]  # searchable by level
+
+
+def test_help_phrase_is_urgent_and_ordinary_speech_is_silent(empty_store, monkeypatch):
+    _, alerts = speech_record(empty_store, monkeypatch, ['살려주세요', '살려주세요', '눈 와주세요', '눈 와주세요'])
+    assert [(a['level'], a['title']) for a in alerts.active()] == [(3, '도움 요청 발화')]
+    record, quiet = speech_record(empty_store, monkeypatch, ['안녕하세요', '길 좀 알려주세요'])
+    assert record['metadata']['help_request']['code'] == 'none' and quiet.active() == []
+
+
+# ---------------------------------------------------------------- vision
+def lying_det(code='lying'):
+    return [dict(target='person', confidence=.9, xyxy=[100., 300., 500., 400.], posture=dict(code=code, label='누워 있음 후보'))]
+
+
+def vision_with_video(store):
+    from alerts import AlertCenter
+    from vision import Vision
+    v = Vision(store)
+    v.alerts = AlertCenter()
+    v.raw_jpeg = jpeg()
+    v.info.update(video=True, last_frame=time.monotonic())
+    v.buffer.append((time.monotonic(), v.raw_jpeg))
+    return v
+
+
+def test_sustained_lying_saves_one_record_and_raises_one_alert(empty_store):
+    v = vision_with_video(empty_store)
+    assert v.lying.sustain == 15.0
+    for i in range(0, 200):                       # 20 s at 10 fps
+        v.track_lying(1000 + i / 10, lying_det())
+    records = empty_store.list()
+    assert [r['title'] for r in records] == ['누운 자세 지속']
+    meta = records[0]['metadata']
+    assert meta['event_kind'] == 'lying_sustained' and meta['lying_sustained']['threshold_seconds'] == 15.0
+    assert meta['detections'][0]['posture']['code'] == 'lying'
+    active = v.alerts.active()
+    assert [(a['level'], a['title'], a['record_ids']) for a in active] == [(2, '누운 자세 지속', [records[0]['id']])]
+    status = v.status()
+    assert status['lying'][0]['sustained'] is True and status['lying'][0]['seconds'] >= 19
+    # the clip is written like any other record
+    v.write_clip(v.pending.pop())
+    assert empty_store.get(records[0]['id'])['state'] in ('ready', 'partial')
+
+
+def test_brief_lying_frames_save_nothing(empty_store):
+    v = vision_with_video(empty_store)
+    for i in range(0, 200):
+        v.track_lying(1000 + i / 10, lying_det('lying' if 50 <= i < 80 else 'standing'))  # 3 s only
+    assert empty_store.list() == [] and v.alerts.active() == []
+
+
+def test_speech_finished_while_lying_goes_on_is_linked(empty_store, monkeypatch):
+    v = vision_with_video(empty_store)
+    for i in range(0, 600):                       # lying for 60 s; sustained fires at 15 s
+        v.track_lying(time.monotonic() - 60 + i / 10, lying_det())
+    from help_request import find_help_request
+    alert = v.alerts.speech(time.monotonic(), find_help_request('사랑해주세요\n사랑해주세요'), 'rec')
+    assert alert['level'] == 3 and '누운 자세 지속 관측 (발화자 미확인)' in alert['message']
+
+
+def test_lying_record_reaches_the_llm_input_and_the_rules(empty_store):
+    import highlights
+    from review_priority import row_from_source, rule_priority
+    v = vision_with_video(empty_store)
+    for i in range(0, 160):
+        v.track_lying(1000 + i / 10, lying_det())
+    v.write_clip(v.pending.pop())
+    source = highlights.make_source(empty_store.list()[0])
+    pose = next(e['text'] for e in source['evidence'] if e['id'] == 'pose')
+    assert pose == '#1 누워 있음 후보 · 누운 자세 15초 이상 지속 관측'
+    assert rule_priority(row_from_source(source))['score'] == 3
+
+
+# ---------------------------------------------------------------- highlights on the real records
+def run_highlights(store, monkeypatch, chat, limit=5):
+    import highlights
+    monkeypatch.setattr(highlights, 'chat', chat)
+    svc = highlights.HighlightsService(store)
+    svc.generate(store.list(), 'qwen3.5:4b', limit)
+    info = svc.status()
+    assert info['error'] == '', info['error']
+    return info['result']['content']
+
+
+def test_real_records_when_the_llm_is_down(store, monkeypatch):
+    def down(payload):
+        raise ConnectionError('Ollama 연결 실패')
+    c = run_highlights(store, monkeypatch, down)
+    assert c['reviewed_count'] == 25 and 'ConnectionError' in c['llm_error']
+    assert [(s['record_id'][:8], s['source']) for s in c['selections']] == [(HELP, 'rule'), (MISHEARD, 'rule')]
+    assert c['selections'][0]['reason'] == "도움 요청 표현 '살려주세요' 2회"
+    assert "'사랑해주세요' 4회 반복" in c['selections'][1]['reason']
+    assert [e['id'] for e in c['selections'][0]['evidence']] == ['speech']
+
+
+def test_real_records_when_the_llm_returns_nothing(store, monkeypatch):
+    c = run_highlights(store, monkeypatch, lambda p: {'message': {'content': '{"selections":[]}'}})
+    assert [s['record_id'][:8] for s in c['selections']] == [HELP, MISHEARD] and c['llm_error'] == ''
+    assert c['rule_selected_count'] == 2 and c['rule_overflow'] == 0
+
+
+def test_real_records_llm_additions_follow_the_rule_picks(store, monkeypatch):
+    def chat(payload):
+        rows = json.loads(payload['messages'][-1]['content'])['records']
+        sitting = [r for r in rows if '앉아 있음' in r.get('pose', '')][:2]
+        heard = [r for r in rows if 'speech' in r][:1]
+        picked = [dict(id=r['id'], reason='앉아 있음 후보 기록', evidence=['pose']) for r in sitting]
+        picked += [dict(id=r['id'], reason='발화 기록이 있어 원본 음성 확인 필요', evidence=['speech', 'time']) for r in heard]
+        return {'message': {'content': json.dumps({'selections': picked}, ensure_ascii=False)}}
+    c = run_highlights(store, monkeypatch, chat)
+    assert [s['source'] for s in c['selections']] == ['rule', 'rule+llm', 'llm', 'llm']
+    assert [s['record_id'][:8] for s in c['selections']][:2] == [HELP, MISHEARD]
+    both = c['selections'][1]
+    assert both['reason'] == '발화 기록이 있어 원본 음성 확인 필요' and "'사랑해주세요' 4회 반복" in both['rule_reason']
+    assert [e['id'] for e in both['evidence']] == ['speech', 'time']
+
+
+def test_no_rule_pick_and_llm_down_is_still_an_error(empty_store, monkeypatch):
+    import highlights
+    v = vision_with_video(empty_store)
+    v.capture()
+    v.write_clip(v.pending.pop())
+
+    def down(payload):
+        raise ConnectionError('Ollama 연결 실패')
+    monkeypatch.setattr(highlights, 'chat', down)
+    svc = highlights.HighlightsService(empty_store)
+    svc.generate(empty_store.list(), 'qwen3.5:4b', 5)
+    assert 'ConnectionError' in svc.status()['error']
+
+
+# ---------------------------------------------------------------- report on the real records
+def test_report_on_the_real_1105_records(store):
+    from patrol_report import ReportService
+    svc = ReportService(store)
+    day = [r for r in store.list() if r['time'].startswith('2026-11-05')]
+    svc.generate(day, 'qwen3.5:4b', use_llm=False, scope='11/05')
+    result = svc.status()['result']
+    f = result['facts']
+    assert (f['date'], f['records'], f['speech_records'], f['help_records'], f['suspect_records']) == ('2026-11-05', 8, 2, 1, 1)
+    assert f['lying_records'] == 0 and f['postures'] == {'앉아 있음 후보': 4, '판단 불가': 3}
+    assert result['overview_source'] == 'rule' and '도움 요청 발화 1건, 도움 요청 의심 발화 1건' in result['overview']
