-            hay = ' '.join([r['title'], r['note'], r['keywords'], ' '.join(r['targets']), str(r['metadata'].get('transcript','')), ' '.join(d.get('posture',{}).get('label','') for d in r['metadata'].get('detections',[]))]).casefold()
+            hay = ' '.join([r['title'], r['note'], r['keywords'], ' '.join(r['targets']), str(r['metadata'].get('transcript','')), str((r['metadata'].get('help_request') or {}).get('label','')), ' '.join(d.get('posture',{}).get('label','') for d in r['metadata'].get('detections',[]))]).casefold()
             if query.casefold() not in hay:continue
             out.append(r)
