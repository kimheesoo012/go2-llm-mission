+    {id:"s1",kind:"speech",level:2,label:"확인 필요",title:"도움 요청 의심 발화",count:1,sound:true,
+     message:"'사랑해주세요' 4회 반복 · '살려주세요'와 유사(0.75) · 원본 음성 확인 필요"}]},
+  {t:25, input:"누운 자세 15초 지속", result:"누운 자세 지속 (긴급 확인)", alerts:[
+    {id:"l1",kind:"lying",level:3,label:"긴급 확인",title:"누운 자세 지속",count:1,sound:true,
+     message:"누운 자세가 15초 이상 이어서 관측됨 · 같은 시간대에 도움 요청 의심 발화 기록 (발화자 미확인)"},
+    {id:"s1",kind:"speech",level:2,label:"확인 필요",title:"도움 요청 의심 발화",count:1,sound:false,
+     message:"'사랑해주세요' 4회 반복 · '살려주세요'와 유사(0.75) · 원본 음성 확인 필요"}]},
+  {t:30, input:"음성 기록: 살려주세요 ×2", result:"도움 요청 (긴급 확인) · 기존 발화 알림을 올림", alerts:[
+    {id:"s1",kind:"speech",level:3,label:"긴급 확인",title:"도움 요청 발화",count:2,sound:true,
+     message:"도움 요청 표현 '살려주세요' 2회 · 같은 시간대에 누운 자세 지속 관측 (발화자 미확인)"},
+    {id:"l1",kind:"lying",level:3,label:"긴급 확인",title:"누운 자세 지속",count:1,sound:false,
+     message:"누운 자세가 15초 이상 이어서 관측됨 · 같은 시간대에 도움 요청 의심 발화 기록 (발화자 미확인)"}]},
+  {t:41, input:"앉은 자세로 바뀜", result:"누운 자세 종료 (알림은 확인 전까지 유지)", alerts:null}
+];
+
+// ---- the part to copy into the console page ---------------------------
+const acked = new Set(), sounded = new Map();
+let audio = null;
+function beep(level){
+  if(!document.getElementById('sound').checked) return;
+  try{
+    audio = audio || new (window.AudioContext || window.webkitAudioContext)();
+    const n = level >= 3 ? 3 : 1;
+    for(let i = 0; i < n; i++){
+      const o = audio.createOscillator(), g = audio.createGain(), at = audio.currentTime + i * .28;
+      o.frequency.value = level >= 3 ? 880 : 660; g.gain.setValueAtTime(.18, at); g.gain.exponentialRampToValueAtTime(.001, at + .22);
+      o.connect(g); g.connect(audio.destination); o.start(at); o.stop(at + .24);
+    }
+  }catch(e){ /* sound is optional */ }
+}
+function renderAlerts(alerts){
+  const box = document.getElementById('alerts'); box.textContent = '';
+  const shown = alerts.filter(a => !acked.has(a.id));
+  for(const a of shown){
+    const row = document.createElement('div'); row.className = 'alert l' + a.level;
+    const tag = document.createElement('span'); tag.className = 'tag'; tag.textContent = a.label;
+    const body = document.createElement('div'); body.className = 'body';
+    const title = document.createElement('div'); title.className = 'title'; title.textContent = a.title + (a.count > 1 ? ' ×' + a.count : '');
+    const msg = document.createElement('div'); msg.className = 'msg'; msg.textContent = a.message;   // textContent: STT text is untrusted
+    body.append(title, msg);
+    const ok = document.createElement('button'); ok.textContent = '확인';
+    ok.onclick = () => { acked.add(a.id); renderAlerts(alerts); };   // console: POST /api/alert_ack {id}
+    row.append(tag, body, ok); box.append(row);
+    if(a.level >= 2 && (sounded.get(a.id) || 0) < a.level){ sounded.set(a.id, a.level); beep(a.level); }  // once per level
+  }
+  document.getElementById('stage').classList.toggle('urgent', shown.some(a => a.level >= 3));
+}
+// -----------------------------------------------------------------------
+
+let timer = null, t = 0, current = [];
+function draw(){
+  document.getElementById('clock').textContent = t.toFixed(1) + '초';
+  const log = document.getElementById('log'); log.textContent = '';
+  for(const s of SCENE){
+    if(s.t > t) break;
+    if(s.alerts) current = s.alerts;
+    const tr = document.createElement('tr'); if(t - s.t < 3) tr.className = 'now';
+    for(const v of [s.t + '초', s.input, s.result]){ const td = document.createElement('td'); td.textContent = v; tr.append(td); }
+    log.append(tr);
+  }
+  renderAlerts(current);
+}
+function reset(){ clearInterval(timer); timer = null; t = 0; current = []; acked.clear(); sounded.clear(); draw(); }
+document.getElementById('play').onclick = () => { if(timer) return; timer = setInterval(() => { t += .5; draw(); if(t >= 45){ clearInterval(timer); timer = null; } }, 100); };
+document.getElementById('reset').onclick = reset;
+const at = new URLSearchParams(location.search).get('t');
+if(at){ t = parseFloat(at); for(const s of SCENE){ if(s.t <= t && s.alerts) current = s.alerts; } }
+draw();
+</script>
+</body>
+</html>
