@@ -0,0 +1,73 @@
+"""자세 판단을 최근 몇 장으로 안정시킨다.
+
+posture_rules.classify_posture 는 한 장만 보고 판단해서, 같은 사람인데 프레임마다
+결과가 바뀔 수 있다(관절이 한두 개 흔들리거나 빠질 때). 사람 상자를 프레임 사이에
+이어 붙이고(겹침 기준), 최근 window 초 동안의 결과로 표시할 자세를 정한다.
+
+정하는 순서
+1. 최근 결과 중 '누워 있음'이 lying_votes 장 이상이면 누워 있음 (누움을 놓치지 않는 쪽을 우선)
+2. 그 밖에는 서 있음·앉음·누움 중 가장 많이 나온 것 (같으면 최근 것)
+3. 판단된 것이 하나도 없으면 이번 프레임 결과 그대로
+
+원래 결과는 posture_raw 에 남긴다. K9_POSTURE_SMOOTH=0 으로 끌 수 있다.
+"""
+import os
+
+from lying_tracker import iou
+
+ENABLED = os.environ.get('K9_POSTURE_SMOOTH', '1') != '0'
+KNOWN = ('standing', 'sitting', 'lying')
+
+
+class PostureSmoother:
+    def __init__(self, window=1.5, gap=1.5, min_iou=.2, lying_votes=2):
+        self.window, self.gap, self.min_iou, self.lying_votes = window, gap, min_iou, lying_votes
+        self.tracks = []   # dict(box, seen, history=[(time, posture)])
+
+    def decide(self, history, current):
+        known = [p for _, p in history if p['code'] in KNOWN]
+        if not known:
+            return current, 0
+        lying = [p for p in known if p['code'] == 'lying']
+        if len(lying) >= self.lying_votes or (lying and len(known) == 1):
+            return lying[-1], len(lying)
+        counts = {}
+        for p in known:
+            counts[p['code']] = counts.get(p['code'], 0) + 1
+        best = max(counts.values())
+        pick = next(p for p in reversed(known) if counts[p['code']] == best)
+        return pick, best
+
+    def update(self, now, detections):
+        """detections 의 사람 항목에 안정시킨 posture 를 넣는다(제자리 수정). 같은 목록을 돌려준다."""
+        self.tracks = [t for t in self.tracks if now - t['seen'] <= self.gap]
+        people = [d for d in detections or [] if d.get('target') == 'person' and isinstance(d.get('posture'), dict)
+                  and len(d.get('xyxy') or []) == 4]
+        pairs = sorted(((iou(t['box'], d['xyxy']), ti, di) for ti, t in enumerate(self.tracks)
+                        for di, d in enumerate(people)), reverse=True)
+        used_t, used_d = set(), set()
+        for score, ti, di in pairs:
+            if score < self.min_iou or ti in used_t or di in used_d:
+                continue
+            used_t.add(ti); used_d.add(di)
+            self._apply(self.tracks[ti], people[di], now)
+        for di, d in enumerate(people):
+            if di not in used_d:
+                track = dict(box=list(d['xyxy']), seen=now, history=[])
+                self.tracks.append(track)
+                self._apply(track, d, now)
+        return detections
+
+    def _apply(self, track, det, now):
+        raw = det['posture']
+        track.update(box=list(det['xyxy']), seen=now)
+        track['history'] = [(t, p) for t, p in track['history'] if now - t <= self.window] + [(now, raw)]
+        pick, votes = self.decide(track['history'], raw)
+        det['posture_raw'] = raw
+        if pick is raw:
+            return
+        shown = dict(pick)
+        shown['reason'] = pick['reason'] + f" · 최근 {len(track['history'])}장 중 {votes}장 기준"
+        shown['smoothed'] = True
+        det['posture'] = shown
+        det['pose_status'] = shown['label']
