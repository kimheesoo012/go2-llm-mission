@@ -0,0 +1,58 @@
+import sys
+from pathlib import Path
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from posture_smooth import PostureSmoother
+
+LABEL = dict(standing='서 있음 후보', sitting='앉아 있음 후보', lying='누워 있음 후보', unknown='판단 불가')
+
+
+def det(code, box=(100, 100, 200, 400)):
+    return dict(target='person', xyxy=list(box), posture=dict(code=code, label=LABEL[code], reason='r', metrics={}))
+
+
+def run(codes, step=.2, **kw):
+    s, out = PostureSmoother(**kw), []
+    for i, code in enumerate(codes):
+        d = det(code)
+        s.update(10 + i * step, [d])
+        out.append(d['posture']['code'])
+    return out
+
+
+def test_single_flicker_is_removed():
+    assert run(['standing', 'standing', 'unknown', 'standing', 'sitting', 'standing']) == ['standing'] * 6
+
+
+def test_two_lying_frames_win_over_more_sitting_frames():
+    assert run(['sitting', 'sitting', 'sitting', 'lying', 'sitting', 'lying'])[-1] == 'lying'
+
+
+def test_one_lying_frame_among_others_does_not_flip():
+    assert run(['standing', 'standing', 'lying', 'standing'])[-1] == 'standing'
+
+
+def test_real_change_follows_within_the_window():
+    out = run(['standing'] * 8 + ['sitting'] * 8)
+    assert out[7] == 'standing' and out[-1] == 'sitting'
+    assert out.index('sitting') - 8 <= 4      # 0.2 s 간격, 1.5 s 창: 5장 안에 바뀐다
+
+
+def test_all_unknown_stays_unknown_and_raw_is_kept():
+    s = PostureSmoother(); d = det('unknown'); s.update(1, [d])
+    assert d['posture']['code'] == 'unknown' and d['posture_raw']['code'] == 'unknown'
+    d2 = det('standing'); s.update(1.2, [d2]); d3 = det('unknown'); s.update(1.4, [d3])
+    assert d3['posture']['code'] == 'standing' and d3['posture_raw']['code'] == 'unknown' and d3['posture']['smoothed']
+
+
+def test_two_people_are_kept_apart():
+    s = PostureSmoother()
+    for i in range(4):
+        a, b = det('standing', (0, 0, 100, 300)), det('lying', (500, 300, 900, 400))
+        s.update(i * .2, [a, b])
+    assert a['posture']['code'] == 'standing' and b['posture']['code'] == 'lying'
+
+
+def test_old_history_is_forgotten_after_a_gap():
+    s = PostureSmoother(); s.update(0, [det('lying')]); s.update(.2, [det('lying')])
+    d = det('standing'); s.update(5, [d])
+    assert d['posture']['code'] == 'standing'
diff --git a/k9_patrol_console/tests/test_review_priority.py b/k9_patrol_console/tests/test_review_priority.py
